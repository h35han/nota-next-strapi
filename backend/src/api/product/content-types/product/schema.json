{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "heading": {
      "type": "string"
    },
    "subheading": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "about": {
      "type": "text"
    },
    "who_for_intro": {
      "type": "text"
    },
    "cta_label": {
      "type": "string"
    },
    "cta_price": {
      "type": "string"
    },
    "availability": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "launching_soon",
        "available",
        "draft"
      ]
    },
    "year": {
      "type": "integer"
    },
    "team": {
      "type": "string"
    },
    "design_credit": {
      "type": "text"
    },
    "built_credit": {
      "type": "text"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "specs_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "specs_image_tablet": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "specs_image_mobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "who_video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "popup_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "popup_logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
