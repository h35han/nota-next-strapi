# Strapi Content API base URL (see backend/.env → PORT)
STRAPI_API_URL=http://localhost:1337/api

# Public origin of the Strapi server (for media/uploads and browser access)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional — API token created in Strapi admin → Settings → API Tokens
# STRAPI_API_TOKEN=

# Public — base URL used by client components
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337/api